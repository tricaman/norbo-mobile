# Deliverfile — opzioni per `fastlane deliver` (upload metadati su App Store Connect).
#
# Autenticazione via App Store Connect API Key (.p8), niente login 2FA interattivo.
# La key è gitignorata (fastlane/AuthKey_*.p8). Key ID / Issuer ID sono identificatori
# pubblici, non segreti; il segreto è solo il contenuto del .p8.

# NB: NON usare `api_key_path` qui. `Spaceship::ConnectAPI::Token.from_json_file`
# pretende il PEM inline nel campo `key` del JSON e ignora `key_filepath`: un
# `fastlane deliver` da CLI fallisce con "API key JSON is missing field(s): key".
# L'autenticazione arriva dal lane `ios metadata`, che passa `api_key:` usando la
# stessa helper dei lane di build — così il segreto resta solo nel .p8.
#
#   fastlane ios metadata

# --- Comportamento upload ---
submit_for_review(false)   # NON invia in review: popola solo la scheda
force(true)                # niente prompt interattivo di conferma HTML preview
skip_screenshots(true)     # gli screenshot li carica l'utente dopo, a mano
skip_binary_upload(true)   # carichiamo SOLO metadati testuali, non il binario
skip_app_version_update(false)

# precheck fa dei controlli extra (es. menzioni di altri brand); teniamolo attivo
run_precheck_before_submit(false)  # non serve: non stiamo submittando

metadata_path("./fastlane/metadata")
