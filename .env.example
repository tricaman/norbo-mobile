# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copia in .env per il dev locale.
# In produzione (EAS Build), queste variabili sono settate automaticamente dai
# profili `preview` / `production` in `eas.json` e NON devono essere in .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── API URLs (DEV) ───────────────────────────────────────────────────────────
# Simulator: usa localhost. Device fisico sulla stessa LAN del Mac:
#   ifconfig | grep -E "inet "       (cerca un 192.168.* o 10.*)
# oppure su macOS:
#   ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws

# ── OAuth deep link scheme (deve coincidere con `scheme` in app.config.ts) ──
EXPO_PUBLIC_AUTH_CALLBACK_SCHEME=norbo

# ── Aggiornamento in-app (solo DEV) ──────────────────────────────────────────
# Forza il gate di aggiornamento in locale, dove nessuno store restituisce un
# update reale per una build di sviluppo: `available` mostra l'icona in header
# + la card (con download simulato), `required` la schermata bloccante.
# Ignorata in produzione (__DEV__ false). Vedi src/hooks/useAppVersion.ts.
# EXPO_PUBLIC_APP_UPDATE_DEV_LEVEL=available

# Google Maps SDK key for Android (tool "luoghi dog friendly").
# Local dev: a key restricted to the .dev package + debug SHA-1.
# EAS builds: injected as an EAS secret (eas secret:create --name ANDROID_MAPS_API_KEY).
# iOS needs no key (Apple Maps via PROVIDER_DEFAULT).
ANDROID_MAPS_API_KEY=
